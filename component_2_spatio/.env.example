# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=dengue_guardian

# Database URL for FastAPI to connect to PostgreSQL
# Note: 'db' is the hostname of the PostgreSQL container in Docker network
DATABASE_URL=postgresql://postgres

# If you ever run main.py locally (without Docker), you would use this instead:
# DATABASE_URL=postgresql://postgres:[pw]@localhost:5432/dengue_guardian